{
  "checkpoint": "answerdotai/ModernBERT-base",
  "batch_size": 16,
  "optimizer": "AdamW",
  "optimizer_defaults": {
    "lr": 2e-05,
    "betas": [
      0.9,
      0.999
    ],
    "eps": 1e-08,
    "weight_decay": 0.01,
    "amsgrad": false,
    "maximize": false,
    "foreach": null,
    "capturable": false,
    "differentiable": false,
    "fused": null,
    "decoupled_weight_decay": true
  },
  "learning_rate": 2e-05,
  "weight_decay": 0.01,
  "manual_seed": true,
  "seed": 42,
  "epochs": 50,
  "patience": 2,
  "learning_rate_schedule": "linear_decay_with_warmup",
  "gradient_clip": 1.0,
  "warmup_ratio": 0.1,
  "amp_enabled": true,
  "selection_metric": "validation_macro_f1",
  "macro_f1_labels": "all_training_labels",
  "max_length": 312,
  "untruncated_train_max_length": 312,
  "model_context_limit": 8192,
  "device": "cuda",
  "input_format": "headline + space + short_description",
  "input_normalization": "NFKC and whitespace; case and punctuation preserved",
  "loading_options": {
    "attn_implementation": "sdpa"
  }
}